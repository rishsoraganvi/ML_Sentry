# ML Sentry configuration template. Copy it to .env and fill in the values:
#   bash:  cp .env.example .env        Windows cmd:  copy .env.example .env
# .env is ignored by Git; never commit it, and keep every value in THIS template empty.
# Every variable is explained in docs/configuration.md.

# --- REQUIRED ---------------------------------------------------------------

# Generate each value below with ONE of (run it once per value):
#   bash / macOS / Linux:  openssl rand -hex 32
#   PowerShell:            $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
# Docker Compose refuses to start until both are set.

# Password for the bundled PostgreSQL service. Letters and digits only.
POSTGRES_PASSWORD=

# SERVICE token: submit evaluations and read. It can never approve anything.
ML_SENTRY_API_TOKEN=

# --- PEOPLE AND RUNNERS -----------------------------------------------------

# Reviewers who approve retraining/deployment: "name:sha256,name2:sha256".
# Create entries with:  docker compose exec api ml-sentry add-reviewer <name>
# ML_SENTRY_REVIEWERS=

# Token for external training runners (e.g. a Colab notebook): claim/report jobs only.
# ML_SENTRY_RUNNER_TOKEN=

# --- POLICY -----------------------------------------------------------------

# ./configs is mounted at /app/configs. For your own model:
#   cp configs/my-model.example.yaml configs/governance.yaml
# ML_SENTRY_POLICY_PATH=/app/configs/governance.yaml

# --- EXECUTION KILL SWITCHES (default false) --------------------------------
# Mock runners/targets never need these. External runners need RETRAINING;
# non-mock release targets (mlflow_alias) need DEPLOYMENT. Humans still approve.
# ML_SENTRY_RETRAINING_ENABLED=false
# ML_SENTRY_DEPLOYMENT_ENABLED=false

# --- NOTIFICATIONS ----------------------------------------------------------
# console (default, logs) | none | slack | telegram | webhook
# ML_SENTRY_NOTIFICATION_PROVIDER=console
# ML_SENTRY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ML_SENTRY_TELEGRAM_BOT_TOKEN=
# ML_SENTRY_TELEGRAM_CHAT_ID=
# ML_SENTRY_WEBHOOK_URL=https://...
# ML_SENTRY_WEBHOOK_SECRET=
# Base URL used in notification links (where reviewers open the UI).
# ML_SENTRY_PUBLIC_URL=http://127.0.0.1:8000

# --- MLFLOW (optional) ------------------------------------------------------
# Bundled server: docker compose --profile mlflow up -d  -> http://mlflow:5000
# ML_SENTRY_MLFLOW_TRACKING_URI=http://mlflow:5000
# Experiments ML Sentry may read (names or IDs). Empty = MLflow ingestion refused.
# ML_SENTRY_MLFLOW_ALLOWED_EXPERIMENTS=
# ML_SENTRY_MLFLOW_TRACKING_TOKEN=
# ML_SENTRY_MLFLOW_USERNAME=
# ML_SENTRY_MLFLOW_PASSWORD=

# --- OTHER ------------------------------------------------------------------
# ML_SENTRY_API_PORT=8000
# POSTGRES_HOST_PORT=5433
# MLFLOW_HOST_PORT=5000
# ML_SENTRY_MAX_REQUEST_BYTES=65536
# ML_SENTRY_LOG_LEVEL=INFO
# ML_SENTRY_WORKER_POLL_SECONDS=2
